[Unit]
Description=TravelMemory Express API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=travelmemory
Group=travelmemory
WorkingDirectory={{ app_root }}/backend
EnvironmentFile=/etc/travelmemory-api.env
ExecStart=/usr/bin/node {{ app_root }}/backend/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target